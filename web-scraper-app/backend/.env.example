# Configuración del Web Scraper Dashboard
# ========================================

# Base de datos SQLite (ruta relativa al directorio backend)
DATABASE_URL=sqlite:///./scraper.db

# Configuración del servidor
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Configuración del scheduler
SCHEDULER_ENABLED=true
SCRAPING_INTERVAL_HOURS=6

# Configuración de scraping
REQUEST_DELAY_MIN=2
REQUEST_DELAY_MAX=5
MAX_RETRIES=3

# Umbral para alertas de cambio de precio (porcentaje)
PRICE_CHANGE_THRESHOLD=10
